# ==============================================================================
# lora-mqtt-bridge Environment Configuration Template
# Copy to .env for local development. NEVER commit real secrets to Git.
# ==============================================================================

# --- MQTT Broker (REQUIRED) ---
MQTT_BROKER=tcp://your-mosquitto-host:1883
MQTT_TOPIC=msh/EU_868/#
MQTT_CLIENT_ID=lora-mqtt-bridge
MQTT_QOS=1
# Optional MQTT authentication (leave empty if broker allows LAN anonymous)
MQTT_USERNAME=your_mqtt_user
MQTT_PASSWORD=your_mqtt_password

# --- InfluxDB v2 (REQUIRED) ---
INFLUX_URL=http://your-influxdb-host:8086
INFLUX_TOKEN=your_token_here
INFLUX_ORG=your_influx_org
INFLUX_BUCKET=meshtastic
INFLUX_BATCH_SIZE=50
INFLUX_FLUSH_INTERVAL=5s

# --- Worker Pool & Runtime Tuning ---
WORKERS=4
QUEUE_SIZE=2048
DROP_ON_BACKPRESSURE=true
HTTP_ADDR=:8080
