{
  "__inputs": [
    {
      "name": "DS_INFLUXDB",
      "label": "InfluxDB v2 (Meshtastic)",
      "description": "InfluxDB v2 Flux Datasource pointing to 081_influxdb (bucket: meshtastic)",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "query": "from(bucket: \"meshtastic\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"meshtastic_telemetry\" and r._field == \"packet_count\")\n  |> group()\n  |> distinct(column: \"node_id\")\n  |> count()",
          "refId": "A"
        }
      ],
      "title": "Active Mesh Nodes",
      "type": "stat"
    },
    {
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": -10 },
              { "color": "green", "value": 0 }
            ]
          },
          "unit": "dB"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["mean"] } },
      "targets": [
        {
          "query": "from(bucket: \"meshtastic\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"meshtastic_telemetry\" and r._field == \"snr\")\n  |> filter(fn: (r) => r.node_id =~ /${node_id:regex}/)\n  |> group()\n  |> mean()",
          "refId": "A"
        }
      ],
      "title": "Avg SNR",
      "type": "stat"
    },
    {
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": -115 },
              { "color": "green", "value": -95 }
            ]
          },
          "unit": "dBm"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["mean"] } },
      "targets": [
        {
          "query": "from(bucket: \"meshtastic\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"meshtastic_telemetry\" and r._field == \"rssi\")\n  |> filter(fn: (r) => r.node_id =~ /${node_id:regex}/)\n  |> group()\n  |> mean()",
          "refId": "A"
        }
      ],
      "title": "Avg RSSI",
      "type": "stat"
    },
    {
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["max"] } },
      "targets": [
        {
          "query": "from(bucket: \"meshtastic\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"meshtastic_telemetry\" and r._field == \"hops\")\n  |> filter(fn: (r) => r.node_id =~ /${node_id:regex}/)\n  |> group()\n  |> max()",
          "refId": "A"
        }
      ],
      "title": "Max Hops Observed",
      "type": "stat"
    },
    {
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "description": "RF Link Quality scatter plot: X = RSSI (dBm), Y = SNR (dB). Top-right indicates strong, clean line-of-sight links.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "pointSize": { "fixed": 6 },
            "show": "points"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "rssi" },
            "properties": [{ "id": "unit", "value": "dBm" }]
          },
          {
            "matcher": { "id": "byName", "options": "snr" },
            "properties": [{ "id": "unit", "value": "dB" }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "options": {
        "dims": { "x": "rssi", "exclude": ["_time"] },
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "series": [
          {
            "name": "SNR vs RSSI",
            "x": "rssi",
            "y": "snr"
          }
        ],
        "seriesMapping": "auto",
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "query": "from(bucket: \"meshtastic\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"meshtastic_telemetry\")\n  |> filter(fn: (r) => r._field == \"snr\" or r._field == \"rssi\")\n  |> filter(fn: (r) => r.node_id =~ /${node_id:regex}/)\n  |> pivot(rowKey: [\"_time\", \"node_id\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.snr and exists r.rssi)\n  |> keep(columns: [\"_time\", \"node_id\", \"rssi\", \"snr\"])",
          "refId": "A"
        }
      ],
      "title": "SNR vs. RSSI Scatter Plot",
      "type": "xychart"
    },
    {
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "description": "Latest battery percentage per Meshtastic node.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "green", "value": 50 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "targets": [
        {
          "query": "from(bucket: \"meshtastic\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"meshtastic_telemetry\" and r._field == \"battery_level\")\n  |> filter(fn: (r) => r.node_id =~ /${node_id:regex}/)\n  |> group(columns: [\"node_id\"])\n  |> last()",
          "refId": "A"
        }
      ],
      "title": "Battery Levels per Node",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "description": "Packets per minute ingested from the LoRa mesh, grouped by packet type.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["sum", "mean"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "query": "from(bucket: \"meshtastic\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"meshtastic_telemetry\" and r._field == \"packet_count\")\n  |> filter(fn: (r) => r.node_id =~ /${node_id:regex}/)\n  |> group(columns: [\"packet_type\"])\n  |> aggregateWindow(every: 1m, fn: count, createEmpty: true)\n  |> yield(name: \"packets_per_min\")",
          "refId": "A"
        }
      ],
      "title": "Mesh Traffic Rate (Packets / min)",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["lora", "meshtastic", "mqtt", "iot-hardware"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
        "includeAll": true,
        "multi": true,
        "name": "node_id",
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"meshtastic\", tag: \"node_id\")",
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "Europe/Berlin",
  "title": "LoRa Mesh Telemetry (Meshtastic / EU_868)",
  "uid": "lora-mesh",
  "version": 1
}
